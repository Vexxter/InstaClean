{
  "name": "instaclean",
  "version": "1.1.0",
  "description": "All-in-one Instagram following/followers analytics for your terminal — scan, verify, report, and optionally clean up who you follow. Uses Instagram's internal API — no scraping, no browser automation.",
  "keywords": [
    "instagram",
    "instagram-analytics",
    "followers",
    "following",
    "follower-audit",
    "unfollow",
    "cli",
    "social-media",
    "instagram-api",
    "unfollowers"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "instaclean": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "cli-progress": "^3.12.0",
    "commander": "^13.1.0",
    "dotenv": "^18.0.4",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
